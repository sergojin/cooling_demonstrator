universe = vanilla
executable = run_chicane_diagnostic_job.sh
arguments = $(point_id) $(config) $(g12_scale) $(g678_scale) $(n_events) pi+ 1600000 $(Cluster)

initialdir = /uscms/homes/s/sergo/g4beamline/cooling_demonstrator/target-transfer-stitched/condor/chicane_group_scan

output = logs/diagnostic_$(Cluster)_point_$(point_id).out
error = logs/diagnostic_$(Cluster)_point_$(point_id).err
log = logs/diagnostic_condor.log

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = inputs, make_resampled_beam.py, scale_chicane_combo.py, summarize_chicane_diagnostic.py, ../source_z2000/combined/source_z2000_pi_mu.csv
transfer_output_files = jobs/$(Cluster)_diag_$(point_id)

request_cpus = 1
request_memory = 2 GB
request_disk = 4 GB

+JobFlavour = "workday"

queue point_id,config,g12_scale,g678_scale,n_events from diagnostic_points.txt
